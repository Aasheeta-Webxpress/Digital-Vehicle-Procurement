# Backend Environment Variables
# Copy this file to .env and fill in your values

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8020
API_RELOAD=True

# CORS Configuration - Add your frontend URLs, NO WILDCARDS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-production-domain.com

# Environment
ENVIRONMENT=development
DEBUG=True

# JWT Authentication - MUST CHANGE IN PRODUCTION
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
